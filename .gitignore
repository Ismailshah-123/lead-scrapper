# Secrets
.env

# Database
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Runtime output (regenerated by the pipeline — do not commit)
logs/*.log
exports/*.xlsx
exports/*.json
exports/*.csv
data/raw/*
data/processed/*
data/verified/*
data/rejected/*

# ...but keep the folders themselves tracked
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/verified/.gitkeep
!data/rejected/.gitkeep
!exports/.gitkeep
!logs/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

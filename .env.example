# Copy this file to .env and fill in what you have.
# Everything is optional at the config level: a connector with no key simply
# logs itself as "unavailable" and the pipeline continues with the rest
# (see app/connectors/base.py -> ConnectorUnavailableError).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/leads.db

# ---------------------------------------------------------------------------
# Google Places API  (Google Maps discovery connector)
# Get a key: https://console.cloud.google.com/google/maps-apis/api-list
# Enable "Places API (New)". Has a limited free monthly allowance, then
# usage-based billing — check Google's current Maps Platform pricing page,
# it has changed more than once. Requires a billing account even to use the
# free allowance.
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Exa Search API (web discovery connector)
# Get a key: https://dashboard.exa.ai/api-keys
# Exa is a separate developer API; a Claude/MCP Exa integration is not the same key.
# ---------------------------------------------------------------------------
EXA_API_KEY=

# ---------------------------------------------------------------------------
# Google Custom Search JSON API  (Google Search discovery connector)
# IMPORTANT: as of 2026 this API is CLOSED TO NEW CUSTOMERS and is being
# fully discontinued on 2027-01-01. Only fill this in if you already have an
# existing, active Custom Search JSON API project. Otherwise leave blank —
# the connector will mark itself unavailable and the pipeline will lean on
# Google Places + website enrichment instead. See README "Compliance notes".
# ---------------------------------------------------------------------------
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# ---------------------------------------------------------------------------
# Meta Ad Library API  (official ad-transparency API, NOT a scraper)
# Setup: business.facebook.com developer app -> identity verification ->
# Ads Library API product -> generate a token.
# IMPORTANT: for ad_reached_countries=US, Meta's API only returns political /
# social-issue ads. Regular commercial ads are only covered when
# ad_reached_countries is a UK/EU country. For a US SMB build this connector
# will mostly come back empty — that's Meta's limitation, not a bug here.
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_API_VERSION=v23.0

# ---------------------------------------------------------------------------
# Facebook Graph API (Pages) — only works for Pages you manage / have been
# granted access to via a Page Access Token, or with Meta App Review for
# broader access. This is NOT a public-page scraper. See
# app/connectors/facebook_pages.py.
# ---------------------------------------------------------------------------
FACEBOOK_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Cold-call brief generation
# LLM_PROVIDER = template | ollama | xai
#   template -> pure Python, no network/model needed
#   ollama   -> calls a local Ollama server
#   xai      -> calls xAI/Grok through the official xAI API
# xAI API docs: https://docs.x.ai/developers/quickstart
# Get an API key from the xAI Console: https://console.x.ai/
# In every mode, only verified fields already in the database are given to
# the model — see app/coldcall/brief.py and llm_provider.py.
# ---------------------------------------------------------------------------
LLM_PROVIDER=template
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
XAI_API_KEY=
XAI_MODEL=grok-4.7

# ---------------------------------------------------------------------------
# Crawling behaviour (website enrichment connector)
# ---------------------------------------------------------------------------
REQUEST_DELAY_SECONDS=1.5
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
USER_AGENT=VertexDataLeadBot/1.0 (+https://vertex-data-system.vercel.app/)
